# Copy to .env.local for local overrides. Not committed (see .gitignore).
#
# The app talks to the real Apps Script backend by default (VITE_USE_MOCK
# unset/false) — see src/api.js. That means VITE_API_URL/VITE_API_TOKEN
# below are required for `npm run dev` / `npm run build` to actually work
# against live data.
#
# Ask whoever deployed the Apps Script Web App (see apps-script/README.md)
# for the URL and the SHARED_TOKEN value, then set:
VITE_API_URL=
VITE_API_TOKEN=

# Local UI work with no backend available? Opt into the in-memory mock
# (src/data/mockMovies.js) instead of the two vars above:
# VITE_USE_MOCK=true
